@model Newtonsoft.Json.Linq.JObject

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Email Template</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
        }
        .container {
            width: 80%;
            margin: 0 auto;
        }
        .header {
            background-color: #f8f8f8;
            padding: 20px;
            text-align: center;
        }
        .content {
            margin: 20px 0;
        }
        .footer {
            background-color: #f8f8f8;
            padding: 10px;
            text-align: center;
            font-size: 0.8em;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Yeni Bayi İsteği</h1>
        </div>
        <div class="content">
            <p><strong>Ad Soyad:</strong> @Model["nameSurname"]</p>
            <p><strong>Ticari Ünvan:</strong> @Model["country"]</p>
            <p><strong>Sektör:</strong> @Model["ctiy"]</p>
            <p><strong>İl:</strong> @Model["treaderName"]</p>
            <p><strong>İlçe:</strong> @Model["sector"]</p>
            <p><strong>Firma Adresi:</strong> @Model["adress"]</p>
            <p><strong>Şirket telefonu</strong> @Model["Phone"]</p>
            <p><strong>GSM:</strong> @Model["GSM"]</p>
            <p><strong>Email:</strong> @Model["emailAdress"]</p>
			            <p><strong>Email:</strong> @Model["approval"]</p>
             
        </div>
        <div class="footer">
            <p>&copy; @DateTime.Now.Year - Morpara</p>
        </div>
    </div>
</body>
</html>
