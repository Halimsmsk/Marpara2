@model Newtonsoft.Json.Linq.JObject

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Email Template</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
        }
        .container {
            width: 80%;
            margin: 0 auto;
        }
        .header {
            background-color: #f8f8f8;
            padding: 20px;
            text-align: center;
        }
        .content {
            margin: 20px 0;
        }
        .footer {
            background-color: #f8f8f8;
            padding: 10px;
            text-align: center;
            font-size: 0.8em;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>MorPos Başvuru Talebiniz Alındı</h1>
        </div>
        <div class="content">
          <p><strong>Ad Soyad:</strong> @Model["nameSurname"] 111</p>
<p><strong>E-Posta Adresi:</strong> @Model["emailAdress"]</p>
<p><strong>Web Siteniz:</strong> @Model["webSite"]</p>
<p><strong>Telefon Numaranız:</strong> @Model["cellPhone"]</p>
<p><strong>Firma İsmi:</strong> @Model["treaderName"]</p>
<p><strong>Onay:</strong> @Model["onay"]</p>


        </div>
        <div class="footer">
            <p>&copy; @DateTime.Now.Year - Morpara</p>
        </div>
    </div>
</body>
</html>