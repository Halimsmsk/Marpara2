<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CompressionEnabled>false</CompressionEnabled> <!-- Disable compression. E.g. for umbraco backoffice files. These files should be precompressed by node and not let dotnet handle it -->
    <!-- Disable TypeScript compilation for App_Plugins -->
    <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Controllers\ContentApiControllerRefactored.cs" />
    
    <!-- 🚫 Temporarily disable BlockFilter-dependent files -->
    <Compile Remove="Composers\BlockGridValidationComposer.cs" />
    <Compile Remove="Notifications\BlockFilterNotificationHandler.cs" />
    
    <!-- 🚫 Exclude libs folder completely to prevent path length issues -->
    <Compile Remove="libs\**\*.cs" />
    <Content Remove="libs\**\*" />
    <None Remove="libs\**\*" />
    
    <!-- 🚫 Specifically exclude node_modules and long paths -->
    <TypeScriptCompile Remove="libs\**\*.ts" />
    <TypeScriptCompile Remove="libs\**\node_modules\**\*" />
    
    <!-- 🚫 Exclude Umbraco test projects that cause conflicts -->
    <Compile Remove="libs\**\Umbraco\**\*.cs" />
    <Content Remove="libs\**\Umbraco\**\*" />
    <None Remove="libs\**\Umbraco\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- ✨ Local Project Reference - Kraftvaerk Block Filter Backend -->
    <PackageReference Include="Cultiv.Hangfire" Version="4.1.3" />
    <!-- 🚫 Temporarily disabled - project file not found -->
    <!-- <ProjectReference Include="libs\kraftvaerk.umbraco.blockfilter-main\kraftvaerk.umbraco.blockfilter.Backend\kraftvaerk.umbraco.blockfilter.Backend.csproj" /> -->
    
    <PackageReference Include="Microsoft.TypeScript.MSBuild" Version="5.9.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Umbraco.Cms" Version="16.4.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <PackageReference Include="UmbracoSeoVisualizer" Version="16.0.1" />
    <PackageReference Include="uSync" Version="16.1.0" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include ALL App_Plugins files as content for Umbraco 16 -->
    <!--<Content Include="App_Plugins\**\*" />
    --><!-- Completely remove App_Plugins from TypeScript compilation --><!--
    <TypeScriptCompile Remove="App_Plugins\**\*.ts" />-->
  </ItemGroup>

  <ItemGroup>
    <Folder Include="App_Plugins\" />
    <Folder Include="Libs\" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
    
    <!-- 🚫 Disable long path processing to avoid Windows path limit -->
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <EnableDefaultContentItems>true</EnableDefaultContentItems>
    <EnableDefaultNoneItems>true</EnableDefaultNoneItems>
  </PropertyGroup>

</Project>
